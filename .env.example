# ============================================================
# DockFlare — Environment Configuration
# Copy to .env and fill in your values.
# Cloudflare credentials (API token, Account ID, Zone ID) are
# configured through the web UI setup wizard, not here.
# ============================================================


# ── Hostnames ────────────────────────────────────────────────────────────────

# Public hostname for the DockFlare admin UI.
DOCKFLARE_HOSTNAME=dockflare.example.com

# Public hostname for the webmail UI (only needed with the email profile).
DOCKFLARE_MAIL_HOSTNAME=mail.example.com

# Public-facing URL of the DockFlare admin UI.
# Used for DockFlare's own OAuth callbacks if you protect the UI with
# Cloudflare Access. Not needed for your other services' OAuth.
DOCKFLARE_PUBLIC_URL=https://dockflare.example.com


# ── Cloudflare Tunnel ────────────────────────────────────────────────────────

# true  = use your existing cloudflared tunnel (recommended for homelabs).
#         DockFlare manages public hostnames via the API only — it will NOT
#         start or stop a cloudflared container.
# false = DockFlare spins up its own cloudflared container via Docker socket.
USE_EXTERNAL_CLOUDFLARED=true

# Your existing tunnel's UUID (required when USE_EXTERNAL_CLOUDFLARED=true).
# Find it at: dash.cloudflare.com → Zero Trust → Networks → Tunnels
EXTERNAL_TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Docker network shared between cloudflared and your services.
# Must already exist: docker network create cloudflare-net
CLOUDFLARED_NETWORK_NAME=cloudflare-net

# Scan ALL Docker networks for labelled containers, not just cloudflare-net.
SCAN_ALL_NETWORKS=false


# ── Security ─────────────────────────────────────────────────────────────────

# Master API key for the /api/v2 endpoints (used by remote agents).
# Generate: openssl rand -hex 32
# Safe to leave unset if you have no remote agents and DockFlare is not
# publicly reachable without Cloudflare Access in front of it.
# DOCKFLARE_API_KEY=


# ── Infrastructure ───────────────────────────────────────────────────────────

# UID/GID the dockflare process runs as inside the container.
# The init container chowns /app/data to this on first start.
DOCKFLARE_UID=65532
DOCKFLARE_GID=65532

# Redis connection (must match the redis service name in compose).
REDIS_URL=redis://redis:6379/0

# Redis database index (0-15). Change if Redis is shared with other apps.
REDIS_DB_INDEX=0

# Docker socket proxy address. Only change if you rename that service.
DOCKER_HOST=tcp://docker-socket-proxy:2375


# ── Email / Webmail (only needed with the `email` compose profile) ───────────

# Internal URL mail-manager uses to call DockFlare master.
DOCKFLARE_MASTER_INTERNAL_URL=http://dockflare:5000

# Public URL the webmail frontend uses for SSO callbacks.
# Must match DOCKFLARE_HOSTNAME above (with https://).
DOCKFLARE_MASTER_PUBLIC_URL=https://dockflare.example.com


# ── Cloudflare Policy Behaviour ──────────────────────────────────────────────

# Use Cloudflare reusable Access policies (more efficient, recommended).
USE_REUSABLE_POLICIES=true

# Also sync Access policies created outside DockFlare.
SYNC_ALL_CLOUDFLARE_POLICIES=false


# ── Agents (multi-server) ────────────────────────────────────────────────────

# Require agents to be enrolled via the UI before they can register.
AGENT_ENROLLMENT_REQUIRED=true

# Seconds without heartbeat before an agent is considered offline.
AGENT_HEARTBEAT_TIMEOUT=60

# How often (seconds) agents poll Master for commands.
AGENT_COMMAND_POLL_INTERVAL=10

# Auto-restore rules reported by agents if they disappear from Master state.
AUTO_RESTORE_AGENT_RULES=true

# Cooldown (seconds) between auto-restore attempts per agent.
AUTO_RESTORE_COOLDOWN_SECONDS=60


# ── Performance ──────────────────────────────────────────────────────────────

# Interval (seconds) between cleanup/reconciliation cycles.
CLEANUP_INTERVAL_SECONDS=60

# Max parallel DNS operations per reconciliation cycle.
MAX_CONCURRENT_DNS_OPS=5

# Rules processed per reconciliation batch.
RECONCILIATION_BATCH_SIZE=5

# Waitress WSGI tuning. Defaults are fine for homelab + a handful of agents.
WAITRESS_PORT=5000
WAITRESS_THREADS=128
WAITRESS_CONNECTION_LIMIT=256

# Expose cloudflared Prometheus metrics on this port (optional).
# CLOUDFLARED_METRICS_PORT=9092


# ── Logging ──────────────────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=WARNING
